# Step 1: Compile the zero-dependency TypeScript API server
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY server ./server
RUN npx tsc -p server/tsconfig.json

# Step 2: Production runtime with Git & OpenSSH client for Server Git-Bridge
FROM node:20-alpine
RUN apk add --no-cache git openssh-client ca-certificates
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0
ENV DATA_DIR=/data
COPY --from=builder /app/server/dist ./server/dist
VOLUME ["/data"]
EXPOSE 4000
CMD ["node", "server/dist/index.js"]
