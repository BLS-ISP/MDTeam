#!/usr/bin/env python3

import os
import secrets
import sys
import agent

sys.path.insert(
    0,
    os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "bin")),
)
from mdteam_helpers import read_secrets_env, write_secrets_env  # noqa: E402


DEFAULT_IMAGES = {
    "WORKSPACE_WEB_IMAGE": "ghcr.io/bls-isp/mdteam/workspace-web:latest",
    "API_SERVER_IMAGE": "ghcr.io/bls-isp/mdteam/api-server:latest",
    "YJS_SERVER_IMAGE": "ghcr.io/bls-isp/mdteam/yjs-server:latest",
}

for env_key, fallback_image in DEFAULT_IMAGES.items():
    if not os.environ.get(env_key):
        agent.set_env(env_key, fallback_image)

agent.set_env("TRAEFIK_HOST", "")
agent.set_env("TRAEFIK_HTTP2HTTPS", "True")
agent.set_env("TRAEFIK_LETS_ENCRYPT", "False")
agent.set_env("LDAP_DOMAIN", "")
agent.set_env("LDAP_DEFAULT_ROLE", "developer")
agent.set_env("LDAP_ADMIN_GROUP", "")
agent.set_env("LDAP_PO_GROUP", "")
agent.set_env("LDAP_SM_GROUP", "")
agent.set_env("LDAP_STAKEHOLDER_GROUP", "")
agent.dump_env()

existing_secrets = read_secrets_env("secrets.env")
jwt_secret = existing_secrets.get("JWT_SECRET") or secrets.token_hex(32)

initial_secrets = {
    "JWT_SECRET": jwt_secret,
    "MDTEAM_JWT_SECRET": jwt_secret,
    "MDTEAM_COOKIE_SECURE": "true",
    "LDAP_ENABLED": "false",
    "LDAP_DOMAIN": "",
    "LDAP_DEFAULT_ROLE": "developer",
    "LDAP_ADMIN_GROUP": "",
    "LDAP_PO_GROUP": "",
    "LDAP_SM_GROUP": "",
    "LDAP_STAKEHOLDER_GROUP": "",
}

write_secrets_env(initial_secrets, "secrets.env")
os.chmod("secrets.env", 0o600)
