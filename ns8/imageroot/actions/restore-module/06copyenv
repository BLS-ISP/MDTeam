#!/usr/bin/env python3

import json
import os
import sys
import agent

EXCLUDED_KEYS = {
    "TCP_PORT",
    "TCP_PORTS",
    "UDP_PORT",
    "UDP_PORTS",
    "MODULE_ID",
    "MODULE_UUID",
    "NODE_ID",
    "AGENT_ID",
    "AGENT_INSTALL_DIR",
    "AGENT_STATE_DIR",
    "IMAGE_ID",
    "IMAGE_URL",
    "IMAGE_DIGEST",
    "IMAGE_REOPODIGEST",
    "WORKSPACE_WEB_IMAGE",
    "API_SERVER_IMAGE",
    "YJS_SERVER_IMAGE",
}

RESTORE_KEYS = {
    "TRAEFIK_HOST",
    "TRAEFIK_HTTP2HTTPS",
    "TRAEFIK_LETS_ENCRYPT",
    "LDAP_DOMAIN",
    "LDAP_DEFAULT_ROLE",
    "LDAP_ADMIN_GROUP",
    "LDAP_PO_GROUP",
    "LDAP_SM_GROUP",
    "LDAP_STAKEHOLDER_GROUP",
}

request = {}
if not sys.stdin.isatty():
    raw_stdin = sys.stdin.read().strip()
    if raw_stdin:
        request = json.loads(raw_stdin)

original_environment = request.get("environment")
if not isinstance(original_environment, dict):
    orig_env_ref = os.environ.get("ORIGINAL_ENVIRONMENT", "")
    if orig_env_ref and os.path.isfile(orig_env_ref):
        original_environment = agent.read_envfile(orig_env_ref)
    elif orig_env_ref:
        try:
            original_environment = json.loads(orig_env_ref)
        except Exception:
            original_environment = {}
    else:
        original_environment = {}

for key, value in original_environment.items():
    if key in EXCLUDED_KEYS:
        continue
    if key in RESTORE_KEYS or not key.startswith(
        ("AGENT_", "PODMAN_", "PATH", "HOME", "USER", "XDG_")
    ):
        agent.set_env(key, str(value))

agent.dump_env()
