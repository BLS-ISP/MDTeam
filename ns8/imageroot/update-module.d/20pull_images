#!/usr/bin/env python3

import os
import secrets
import sys
import agent

sys.path.insert(
    0,
    os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "bin")),
)
from mdteam_helpers import read_secrets_env, write_secrets_env  # noqa: E402

IMAGES = [
    os.environ.get(
        "WORKSPACE_WEB_IMAGE", "ghcr.io/bls-isp/mdteam/workspace-web:latest"
    ),
    os.environ.get("API_SERVER_IMAGE", "ghcr.io/bls-isp/mdteam/api-server:latest"),
    os.environ.get("YJS_SERVER_IMAGE", "ghcr.io/bls-isp/mdteam/yjs-server:latest"),
]

for image in IMAGES:
    agent.run_helper("podman", "pull", image).check_returncode()

existing_secrets = read_secrets_env("secrets.env")
jwt_secret = existing_secrets.get("JWT_SECRET") or secrets.token_hex(32)
existing_secrets["JWT_SECRET"] = jwt_secret
existing_secrets["MDTEAM_JWT_SECRET"] = jwt_secret
write_secrets_env(existing_secrets, "secrets.env")
os.chmod("secrets.env", 0o600)

agent.run_helper("systemctl", "--user", "daemon-reload").check_returncode()

is_active = agent.run_helper(
    "systemctl", "--user", "is-active", "--quiet", "mdteam.service"
)
if is_active.returncode == 0 or os.environ.get("TRAEFIK_HOST"):
    agent.run_helper(
        "systemctl", "--user", "restart", "mdteam.service"
    ).check_returncode()
