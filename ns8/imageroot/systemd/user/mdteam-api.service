[Unit]
Description=Podman mdteam-api.service
BindsTo=mdteam.service
After=mdteam.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=120
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/mdteam-api.pid %t/mdteam-api.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/mdteam-api.pid --cidfile %t/mdteam-api.ctr-id --cgroups=no-conmon --pod-id-file %t/mdteam.pod-id --replace -d --pull=missing --restart=on-failure --name mdteam-api --volume mdteam-data:/data:Z --env-file=%S/state/environment --env-file=%S/state/secrets.env --env NODE_ENV=production --env PORT=4000 --env HOST=0.0.0.0 --env DATA_DIR=/data ${API_SERVER_IMAGE}
ExecStartPost=/usr/bin/podman exec mdteam-api /bin/sh -c 'i=0; while [ $$i -lt 30 ]; do wget -qO- http://127.0.0.1:4000/api/health >/dev/null 2>&1 && exit 0; i=$$((i+1)); sleep 1; done; exit 1'
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/mdteam-api.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/mdteam-api.ctr-id
PIDFile=%t/mdteam-api.pid
Type=forking
