[Unit]
Description=Podman mdteam.service
Requires=mdteam-api.service mdteam-yjs.service mdteam-web.service
Before=mdteam-api.service mdteam-yjs.service mdteam-web.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/mdteam.pid %t/mdteam.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/mdteam.pid --pod-id-file %t/mdteam.pod-id --name mdteam --replace --publish 127.0.0.1:${TCP_PORT}:80 --network=slirp4netns:allow_host_loopback=true --add-host=accountprovider:10.0.2.2 --add-host=api-server:127.0.0.1 --add-host=yjs-server:127.0.0.1
ExecStart=/usr/bin/podman pod start --pod-id-file %t/mdteam.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/mdteam.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/mdteam.pod-id
PIDFile=%t/mdteam.pid
Type=forking

[Install]
WantedBy=default.target
